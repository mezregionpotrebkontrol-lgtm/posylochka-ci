# Защита служебных файлов и папок CRM от прямого доступа через браузер
Options -Indexes

# config.php (пароли и ключи) и все журналы *.log (там телефоны клиентов,
# ответы платёжной системы) — только для сервера, не для браузера.
<IfModule mod_authz_core.c>
    <FilesMatch "^(config\.php|.*\.log|.*\.sql|.*\.sql\.gz)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config\.php|.*\.log|.*\.sql|.*\.sql\.gz)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
